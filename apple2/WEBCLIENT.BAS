10 REM ========================================
20 REM APPLE //e SUPER SERIAL WEB CLIENT
30 REM COMMUNICATES WITH NODE.JS SERVER
40 REM VIA SUPER SERIAL CARD (SLOT 2)
50 REM ========================================
60 TEXT : HOME 
70 DTR = 49320: REM $C0A8 DATA REGISTER
80 STR = 49321: REM $C0A9 STATUS REGISTER
90 CMD = 49322: REM $C0AA COMMAND REGISTER
100 CTL = 49323: REM $C0AB CONTROL REGISTER
110 KBD = 49152: REM $C000 KEYBOARD DATA
120 KCL = 49168: REM $C010 KEYBOARD STROBE CLEAR
130 REM INIT ACIA: 9600 BAUD, 8-N-1, DTR/RTS ON
140 POKE CTL, 30: POKE CMD, 11
150 REM FLUSH ANY RESIDUAL BYTES IN BUFFER
160 IF (PEEK(STR) AND 8) = 8 THEN C = PEEK(DTR): GOTO 160
170 REM ----------------------------------------
180 REM MAIN MENU
190 REM ----------------------------------------
200 HOME 
210 VTAB 2: HTAB 4: PRINT "APPLE //e WEB CLIENT & SERIAL BRIDGE"
220 VTAB 3: HTAB 4: PRINT "------------------------------------"
230 VTAB 5: PRINT " 1. LIVE TERMINAL & CHAT"
240 VTAB 7: PRINT " 2. GET SERVER TIME   (/api/time)"
250 VTAB 9: PRINT " 3. GET RETRO QUOTE   (/api/quote)"
260 VTAB 11: PRINT " 4. GET WEATHER       (/api/weather)"
270 VTAB 13: PRINT " 5. GET SERVER STATUS (/api/status)"
280 VTAB 15: PRINT " 6. CUSTOM HTTP REQUEST"
290 VTAB 17: PRINT " 7. PING TEST"
300 VTAB 19: PRINT " 8. EXIT TO BASIC"
310 VTAB 22: PRINT "SELECT OPTION (1-8): ";
320 GET CH$: PRINT CH$
330 IF CH$ = "1" THEN GOSUB 1000: GOTO 200
340 IF CH$ = "2" THEN GOSUB 2000: GOTO 200
350 IF CH$ = "3" THEN GOSUB 3000: GOTO 200
360 IF CH$ = "4" THEN GOSUB 4000: GOTO 200
370 IF CH$ = "5" THEN GOSUB 5000: GOTO 200
380 IF CH$ = "6" THEN GOSUB 6000: GOTO 200
390 IF CH$ = "7" THEN GOSUB 7000: GOTO 200
400 IF CH$ = "8" THEN HOME : END 
410 GOTO 200
500 REM ----------------------------------------
510 REM SUBROUTINE: SEND STRING IN S$
520 REM ----------------------------------------
530 FOR I = 1 TO LEN(S$)
540   C = ASC(MID$(S$, I, 1))
550   WAIT STR, 16: POKE DTR, C
560 NEXT I
570 WAIT STR, 16: POKE DTR, 13
580 WAIT STR, 16: POKE DTR, 10
590 RETURN 
600 REM ----------------------------------------
610 REM SUBROUTINE: RECEIVE & PRINT RESPONSE
620 REM ----------------------------------------
630 PRINT : PRINT "--- RESPONSE FROM NODE.JS SERVER ---"
640 T = 0
650 IF (PEEK(STR) AND 8) = 8 GOTO 700
660 T = T + 1: IF T < 4000 GOTO 650
670 PRINT : PRINT "[TIMEOUT: NO MORE DATA]"
680 GOTO 750
700 C = PEEK(DTR) AND 127
710 T = 0
720 IF C = 10 GOTO 650: REM SKIP LF
730 IF C = 13 THEN PRINT : GOTO 650
740 PRINT CHR$(C);: GOTO 650
750 PRINT "------------------------------------"
760 PRINT "PRESS ANY KEY TO RETURN TO MENU...";
770 GET K$: RETURN 
1000 REM ----------------------------------------
1010 REM 1. LIVE TERMINAL & CHAT MODE
1020 REM ----------------------------------------
1030 HOME 
1040 PRINT "=== LIVE TERMINAL & CHAT MODE ==="
1050 PRINT "TYPE TO COMMUNICATE WITH SERVER/WEB"
1060 PRINT "PRESS [ESC] TO RETURN TO MENU"
1070 PRINT "================================="
1080 REM SEND HELLO
1090 S$ = "CHAT Apple //e Client Online!": GOSUB 500
1100 REM MAIN TERMINAL LOOP
1110 K = PEEK(KBD)
1120 IF K < 128 GOTO 1200
1130 POKE KCL, 0
1140 KC = K - 128
1150 IF KC = 27 THEN RETURN : REM ESC TO EXIT
1160 IF KC = 13 THEN PRINT : WAIT STR, 16: POKE DTR, 13: WAIT STR, 16: POKE DTR, 10: GOTO 1200
1170 PRINT CHR$(KC);: WAIT STR, 16: POKE DTR, KC
1200 REM CHECK SERIAL INCOMING
1210 IF (PEEK(STR) AND 8) = 0 GOTO 1110
1220 RC = PEEK(DTR) AND 127
1230 IF RC = 10 GOTO 1110
1240 IF RC = 13 THEN PRINT : GOTO 1110
1250 PRINT CHR$(RC);
1260 GOTO 1110
