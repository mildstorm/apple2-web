10 REM ========================================
20 REM APPLE //e SUPER SERIAL WEB CLIENT
30 REM COMMUNICATES WITH NODE.JS SERVER
40 REM VIA SUPER SERIAL CARD (SLOT 2)
50 REM ========================================
60 TEXT : HOME 
70 DTR = 49320: REM $C0A8 DATA REGISTER
80 STR = 49321: REM $C0A9 STATUS REGISTER
90 CMD = 49322: REM $C0AA COMMAND REGISTER
100 CTL = 49323: REM $C0AB CONTROL REGISTER
110 KBD = 49152: REM $C000 KEYBOARD DATA
120 KCL = 49168: REM $C010 KEYBOARD STROBE CLEAR
130 REM INIT ACIA: 9600 BAUD, 8-N-1, DTR/RTS ON
140 POKE CTL, 30: POKE CMD, 11
150 REM FLUSH ANY RESIDUAL BYTES IN BUFFER
160 IF (PEEK(STR) AND 8) = 8 THEN C = PEEK(DTR): GOTO 160
170 REM ----------------------------------------
180 REM MAIN MENU
190 REM ----------------------------------------
200 HOME 
210 VTAB 2: HTAB 4: PRINT "APPLE //e WEB CLIENT & SERIAL BRIDGE"
220 VTAB 3: HTAB 4: PRINT "------------------------------------"
230 VTAB 5: PRINT " 1. INTERACTIVE WEB CONSOLE (CHAT/CMD)"
240 VTAB 7: PRINT " 2. LIVE FULL-DUPLEX TERMINAL"
250 VTAB 9: PRINT " 3. GET SERVER TIME   (/api/time)"
260 VTAB 11: PRINT " 4. GET RETRO QUOTE   (/api/quote)"
270 VTAB 13: PRINT " 5. GET WEATHER       (/api/weather)"
280 VTAB 15: PRINT " 6. GET SERVER STATUS (/api/status)"
290 VTAB 17: PRINT " 7. CUSTOM HTTP REQUEST"
300 VTAB 19: PRINT " 8. PING TEST"
310 VTAB 21: PRINT " 9. EXIT TO BASIC"
320 VTAB 23: PRINT "SELECT OPTION (1-9): ";
330 GET CH$: PRINT CH$
340 IF CH$ = "1" THEN GOSUB 1000: GOTO 200
350 IF CH$ = "2" THEN GOSUB 1500: GOTO 200
360 IF CH$ = "3" THEN GOSUB 2000: GOTO 200
370 IF CH$ = "4" THEN GOSUB 3000: GOTO 200
380 IF CH$ = "5" THEN GOSUB 4000: GOTO 200
390 IF CH$ = "6" THEN GOSUB 5000: GOTO 200
400 IF CH$ = "7" THEN GOSUB 6000: GOTO 200
410 IF CH$ = "8" THEN GOSUB 7000: GOTO 200
420 IF CH$ = "9" THEN HOME : END 
430 GOTO 200
500 REM ----------------------------------------
510 REM SUBROUTINE: SEND STRING IN S$
520 REM ----------------------------------------
530 FOR I = 1 TO LEN(S$)
540   C = ASC(MID$(S$, I, 1))
550   WAIT STR, 16: POKE DTR, C
560 NEXT I
570 WAIT STR, 16: POKE DTR, 13
580 WAIT STR, 16: POKE DTR, 10
590 RETURN 
600 REM ----------------------------------------
610 REM SUBROUTINE: RECEIVE & PRINT RESPONSE
620 REM ----------------------------------------
630 PRINT : PRINT "--- RESPONSE FROM NODE.JS SERVER ---"
640 T = 0
650 IF (PEEK(STR) AND 8) = 8 GOTO 700
660 T = T + 1: IF T < 4000 GOTO 650
670 PRINT : PRINT "[TIMEOUT: NO MORE DATA]"
680 GOTO 750
700 C = PEEK(DTR) AND 127
710 T = 0
720 IF C = 10 GOTO 650: REM SKIP LF
730 IF C = 13 THEN PRINT : GOTO 650
740 PRINT CHR$(C);: GOTO 650
750 PRINT "------------------------------------"
760 PRINT "PRESS ANY KEY TO CONTINUE...";
770 GET K$: RETURN 
1000 REM ----------------------------------------
1010 REM 1. INTERACTIVE WEB CONSOLE (CHAT / CMD)
1020 REM ----------------------------------------
1030 HOME 
1040 PRINT "=== APPLE //e INTERACTIVE WEB CONSOLE ==="
1050 PRINT "TYPE MESSAGE OR COMMAND & PRESS [ENTER]"
1060 PRINT "COMMANDS: HELP, TIME, QUOTE, WEATHER..."
1070 PRINT "TYPE 'EXIT' TO RETURN TO MAIN MENU"
1080 PRINT "=========================================="
1090 S$ = "CHAT Apple //e Console Online!": GOSUB 500
1100 PRINT 
1110 PRINT "> ";
1120 INPUT "";L$
1130 IF L$ = "EXIT" OR L$ = "QUIT" THEN RETURN 
1140 IF L$ = "" GOTO 1110
1150 S$ = L$: GOSUB 500
1160 GOSUB 600
1170 GOTO 1100
1500 REM ----------------------------------------
1510 REM 2. LIVE FULL-DUPLEX TERMINAL
1520 REM ----------------------------------------
1530 HOME 
1540 PRINT "=== LIVE FULL-DUPLEX TERMINAL ==="
1550 PRINT "CHARACTERS STREAM LIVE OVER SERIAL"
1560 PRINT "PRESS [ESC] TO RETURN TO MENU"
1570 PRINT "================================="
1580 POKE KCL, 0
1590 K = PEEK(KBD): IF K < 128 GOTO 1630
1600 POKE KCL, 0: KC = K - 128
1610 IF KC = 27 THEN PRINT : RETURN 
1620 WAIT STR, 16: POKE DTR, KC: PRINT CHR$(KC);
1630 IF (PEEK(STR) AND 8) = 0 GOTO 1590
1640 RC = PEEK(DTR) AND 127
1650 IF RC = 10 GOTO 1590
1660 IF RC = 13 THEN PRINT : GOTO 1590
1670 PRINT CHR$(RC);
1680 GOTO 1590
