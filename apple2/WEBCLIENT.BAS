6010 REM 6. CUSTOM HTTP REQUEST
6020 REM ----------------------------------------
6030 HOME 
6040 PRINT "=== CUSTOM HTTP REQUEST ==="
6050 PRINT "EXAMPLE PATHS: /api/time, /api/quote"
6060 PRINT "ENTER PATH: ";
6070 INPUT P$
6080 IF P$ = "" THEN RETURN 
6090 IF LEFT$(P$, 1) <> "/" THEN P$ = "/" + P$
6100 S$ = "GET " + P$ + " HTTP/1.0": GOSUB 500
6110 GOSUB 600: RETURN 
